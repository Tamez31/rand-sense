{
  "name": "randsense",
  "version": "1.0.0",
  "description": "RandSense Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.randsense.app",
    "productName": "RandSense",
    "win": {
      "target": "nsis",
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*",
      "!.git/**",
      "!*.md",
      "!prompt*.txt"
    ]
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "puppeteer": "^25.4.0"
  }
}
